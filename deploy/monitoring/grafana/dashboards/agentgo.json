        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agentgo_http_errors_total[5m])) / clamp_min(sum(rate(agentgo_http_requests_total[5m])), 0.000001)",
          "legendFormat": "错误率"
