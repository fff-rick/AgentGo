# 复制为 .env 后按部署环境修改；真实密钥只写入 .env，不要提交。
# Compose 会自动读取 .env；make run 和 make tui 也会读取。

# ---------- 构建、服务入口与 TUI ----------
# AgentGo 镜像名称；docker compose build 生成此镜像。
AGENTGO_IMAGE=ai-agent-go:local
# HTTP 端口绑定地址；默认只允许本机访问。
AGENTGO_BIND_HOST=127.0.0.1
# 宿主机 HTTP 端口；容器内固定监听 8080。
AGENTGO_PORT=8080
# 仅直接运行 make run 时使用；Compose 容器内端口固定为 8080。
APP_SERVER_PORT=8080
# Docker 构建阶段的 Go 模块代理，逗号后的 direct 表示代理失败时直连。
GOPROXY=https://goproxy.cn,direct
# 运行环境标识；当前仅传入容器，不改变业务行为。
APP_ENV=development
# Gin 模式：debug、release 或 test。
APP_SERVER_MODE=release
# HTTP 读取完整请求的最长时间。
APP_SERVER_READ_TIMEOUT=60s
# HTTP 写入响应的最长时间；流式对话应留出足够时间。
APP_SERVER_WRITE_TIMEOUT=300s
# TUI 连接的 AgentGo 地址；容器外运行 TUI 时使用宿主机端口。
AGENTGO_API_URL=http://localhost:8080
# TUI 在本地无鉴权模式下使用的用户 ID。
AGENTGO_USER_ID=local-user
# TUI 访问启用 OIDC 的服务时使用的 Bearer token；本地模式留空。
AGENTGO_ACCESS_TOKEN=

# ---------- HTTP 鉴权 ----------
# 是否启用 OIDC；启用后须同时设置 issuer 和 audience。
APP_AUTH_ENABLED=false
# OIDC 签发者 URL，须与令牌中的 iss 一致。
APP_AUTH_ISSUER=
# OIDC 受众，须与令牌中的 aud 一致。
APP_AUTH_AUDIENCE=

# ---------- Redis：会话、消息与缓存 ----------
# Redis 地址；Compose 内固定使用 redis:6379，此值供 make run 使用。
APP_REDIS_ADDR=localhost:6379
# Redis 密码；默认 Redis 服务未设置密码。
APP_REDIS_PASSWORD=
# Redis 逻辑数据库编号。
APP_REDIS_DB=0
# Redis 连接池大小。
APP_REDIS_POOL_SIZE=20
# Redis 单次读取超时。
APP_REDIS_READ_TIMEOUT=3s
# Redis 单次写入超时。
APP_REDIS_WRITE_TIMEOUT=3s

# ---------- PostgreSQL：文档索引与长期记忆 ----------
# PostgreSQL 对宿主机暴露的端口。
POSTGRES_PORT=5432
# 数据库地址；Compose 内固定使用 postgres，此值供 make run 使用。
APP_POSTGRES_HOST=localhost
# 数据库服务端口；Compose 内固定使用 5432，此值供 make run 使用。
APP_POSTGRES_PORT=5432
# 数据库用户名，同时用于初始化 Compose 的 PostgreSQL。
APP_POSTGRES_USER=postgres
# 数据库密码，同时用于初始化 Compose 的 PostgreSQL；已有数据卷不会因修改而重设密码。
APP_POSTGRES_PASSWORD=postgres
# 数据库名称，同时用于初始化 Compose 的 PostgreSQL。
APP_POSTGRES_DBNAME=ai_agent
# PostgreSQL SSL 模式，例如 disable、require。
APP_POSTGRES_SSL_MODE=disable
# database_query 工具单次查询超时。
APP_POSTGRES_QUERY_TIMEOUT=10s
# database_query 工具最多返回的行数。
APP_POSTGRES_MAX_ROWS=100

# ---------- Milvus：文档与记忆向量 ----------
# Milvus 镜像及版本。
MILVUS_IMAGE=milvusdb/milvus:v2.5.27
# Milvus gRPC 对宿主机暴露的端口。
MILVUS_PORT=19530
# Milvus HTTP 管理接口对宿主机暴露的端口。
MILVUS_WEBUI_PORT=19121
# Milvus 地址；Compose 内固定使用 milvus-standalone:19530，此值供 make run 使用。
APP_MILVUS_ADDR=localhost:19530
# Milvus 用户名；未启用 Milvus 鉴权时留空。
APP_MILVUS_USERNAME=
# Milvus 密码；未启用 Milvus 鉴权时留空。
APP_MILVUS_PASSWORD=
# Milvus database 名称。
APP_MILVUS_DATABASE=default
# 文档向量 collection；更换 Embedding 模型时改用新名称并重新导入文档。
APP_MILVUS_COLLECTION_NAME=documents_bge_m3
# Milvus 向量维度，必须与 APP_EMBEDDING_DIMENSION 一致。
APP_MILVUS_DIMENSION=1024
# 向量相似度：COSINE、L2 或 IP。
APP_MILVUS_METRIC_TYPE=COSINE
# 启动时连接 Milvus 和初始化 collection 的超时。
APP_MILVUS_CONNECT_TIMEOUT=60s

# ---------- LLM 模型路由 ----------
# config.yaml 中主模型的 API 根地址。
APP_LLM_BASE_URL=https://api.openai.com
# config.yaml 中主模型的 API Key；使用真实服务时填写。
APP_LLM_API_KEY=
# config.yaml 中本地 Qwen 的 OpenAI 兼容 API 根地址。
APP_QWEN_BASE_URL=http://host.docker.internal:11434
# 本地 Qwen 的 API Key；无鉴权的 Ollama 保留占位值 ollama。
APP_QWEN_API_KEY=ollama
# 仅在配置文件没有 llm.models 列表时作为单模型回退配置；默认 config.yaml 已定义模型列表。
APP_LLM_MODEL=qwen2.5:7b
# 单模型回退配置的客户端名称；默认 config.yaml 下不生效。
APP_LLM_NAME=default
# 单模型回退配置的提供方；默认 config.yaml 下不生效。
APP_LLM_PROVIDER=openai-compatible
# 单次 LLM HTTP 请求超时。
APP_LLM_REQUEST_TIMEOUT=180s
# 模型连续失败多少次后打开熔断器。
APP_LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# 半开状态下连续成功多少次后恢复。
APP_LLM_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
# 熔断器打开后的冷却时间。
APP_LLM_CIRCUIT_BREAKER_TIMEOUT=30s

# ---------- Agent 与 Planner ----------
# Agent Loop 最多执行的迭代次数。
APP_AGENT_MAX_ITERATIONS=10
# 一次 Agent 执行的总超时。
APP_AGENT_DEFAULT_TIMEOUT=120s
# 是否启用回答后的反思调用；会增加一次模型请求。
APP_AGENT_ENABLE_REFLECTION=false
# 工具调用决策使用的已注册模型名称；默认配置为本地 Qwen。
APP_AGENT_TOOL_MODEL=qwen-tools

# ---------- Embedding ----------
# 不填 API Key 时为 Ollama 根地址；填 Key 时为 OpenAI 兼容的 /v1 或 /v1/embeddings 地址。
APP_EMBEDDING_BASE_URL=http://host.docker.internal:11434
# Embedding 模型标识；Cloudflare 示例为 @cf/qwen/qwen3-embedding-0.6b。
APP_EMBEDDING_MODEL=bge-m3:latest
# 填写后通过 Bearer 鉴权调用 OpenAI 兼容 Embedding API；留空使用 Ollama /api/embed。
APP_EMBEDDING_API_KEY=
# Embedding 输出维度；更换模型时核对 APP_MILVUS_DIMENSION。
APP_EMBEDDING_DIMENSION=1024
# 每次 Embedding 请求最多包含的文本条数。
APP_EMBEDDING_BATCH_SIZE=32
# Embedding HTTP 请求超时。
APP_EMBEDDING_TIMEOUT=120s

# ---------- 长期记忆与上下文 ----------
# 用户、会话和消息在 Redis 中的滑动有效期。
APP_MEMORY_SESSION_TTL=720h
# 长期记忆的 Milvus collection；更换 Embedding 模型时改用新名称。
APP_MEMORY_SEMANTIC_COLLECTION=semantic_memory_v2
# 每次上下文构建最多召回的长期记忆条数。
APP_MEMORY_SEMANTIC_TOP_K=5
# 后台长期记忆提取的总超时；包含其 LLM 和后续处理。
APP_MEMORY_EXTRACTION_TIMEOUT=10s
# 长期记忆候选项的最低重要性分数。
APP_MEMORY_EXTRACTION_MIN_IMPORTANCE=0.7
# 每次提取最多保存的长期记忆条数。
APP_MEMORY_EXTRACTION_MAX_ITEMS=5
# 构建模型上下文时的估算输入 token 预算。
APP_CONTEXT_MAX_INPUT_TOKENS=30000
# 压缩上下文时优先保留的最近消息条数。
APP_CONTEXT_RECENT_MESSAGES=20
# 历史摘要的目标 token 上限。
APP_CONTEXT_SUMMARY_MAX_TOKENS=2000

# ---------- 工具与 RAG ----------
# 超过此工具数时启用工具 Schema 惰性加载。
APP_TOOLS_LAZY_LOAD_THRESHOLD=3
# 单次 Agent 执行最多调用 list_tools 的次数。
APP_TOOLS_MAX_DISCOVERY_CALLS=4
# 知识检索最多返回的片段数。
APP_RAG_TOP_K=5
# 向量召回的最低相关性分数。
APP_RAG_SCORE_THRESHOLD=0.5
# 文档分块的目标大小。
APP_RAG_CHUNK_SIZE=512
# 相邻文档分块的重叠大小。
APP_RAG_CHUNK_OVERLAP=64
# 是否让 LLM 对检索结果重新排序。
APP_RAG_ENABLE_RERANK=true

# ---------- 网络搜索与文档解析 ----------
# SearXNG 镜像及版本。
SEARXNG_IMAGE=searxng/searxng:latest
# SearXNG 对宿主机暴露的端口。
SEARXNG_PORT=7070
# SearXNG 实例密钥；共享部署时更换。
SEARXNG_SECRET=agentgo-local-search-change-me
# 搜索服务地址；Compose 内固定使用 http://searxng:8080，此值供 make run 使用。
APP_SEARCH_BASE_URL=http://localhost:7070
# 单次网络搜索超时。
APP_SEARCH_TIMEOUT=20s
# 网络搜索语言。
APP_SEARCH_LANGUAGE=zh-CN
# 搜索安全级别：0 关闭、1 适中、2 严格。
APP_SEARCH_SAFE_SEARCH=1
# Docling 对宿主机暴露的端口。
DOCLING_PORT=5001
# Docling 同步解析请求允许等待的最长秒数。
DOCLING_SERVE_MAX_SYNC_WAIT=600
# Docling 地址；Compose 内固定使用 http://docling:5001，此值供 make run 使用。
APP_DOCUMENT_DOCLING_URL=http://localhost:5001
# 单个文档的 Docling 解析超时。
APP_DOCUMENT_PARSE_TIMEOUT=10m

# ---------- 日志、指标与 Trace ----------
# 日志等级：debug、info、warn 或 error。
APP_LOG_LEVEL=info
# 日志格式：json 或 text。
APP_LOG_FORMAT=json
# Prometheus 对宿主机本地暴露的端口。
PROMETHEUS_PORT=9090
# Grafana 对宿主机本地暴露的端口。
GRAFANA_PORT=3000
# Grafana 管理员用户名。
GRAFANA_ADMIN_USER=admin
# Grafana 管理员密码；首次部署前建议修改，已有数据卷不会因修改而自动重置。
GRAFANA_ADMIN_PASSWORD=admin
# Tempo 对宿主机本地暴露的端口。
TEMPO_PORT=3200
# OTLP gRPC 导出地址；留空时 Compose 指向内部 Tempo，直接运行时不启用导出。
OTEL_EXPORTER_OTLP_ENDPOINT=
# 仅 Trace 的 OTLP 地址；留空时使用上一项。
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTLP 是否使用明文连接；本地 Tempo 使用 true。
OTEL_EXPORTER_OTLP_INSECURE=true
# Trace 采样器；默认按父 span 决定采样并按 Trace ID 采样新请求。
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# 新请求采样比例，0 到 1；1 表示全量采样。
OTEL_TRACES_SAMPLER_ARG=1.0

# ---------- 测试与基准（不由 Compose 传入服务） ----------
# 设为 1 时运行 PostgreSQL 集成测试；直接执行 go test 前需导出此变量。
POSTGRES_INTEGRATION=0
# 设为 1 时运行 Milvus 集成测试；make test-milvus 会自行设置为 1。
MILVUS_INTEGRATION=0
# 以下 BENCH_* 由 make benchmark-e2e 使用；先执行 set -a; . ./.env; set +a，或通过 make 参数覆盖。
# 黑盒基准测试的 AgentGo 地址。
BENCH_URL=http://localhost:8080
# 黑盒基准测试的数据集路径。
BENCH_DATASET=benchmarks/datasets/smoke.example.jsonl
# 黑盒基准测试的并发数。
BENCH_CONCURRENCY=1
# 黑盒基准测试每条样本的重复次数。
BENCH_REPEAT=1
