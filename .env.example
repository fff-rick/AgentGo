# 复制为 .env 后按环境修改；不要提交真实密钥。

AGENTGO_IMAGE=ai-agent-go:local
AGENTGO_PORT=8080
AGENTGO_API_URL=http://localhost:8080
APP_ENV=development
APP_SERVER_MODE=release
APP_SERVER_READ_TIMEOUT=60s
APP_SERVER_WRITE_TIMEOUT=300s
APP_AGENT_ENABLE_REFLECTION=false

APP_REDIS_ADDR=localhost:6379
APP_REDIS_PASSWORD=
APP_REDIS_DB=0
APP_REDIS_POOL_SIZE=20

POSTGRES_PORT=5432
APP_POSTGRES_HOST=localhost
APP_POSTGRES_PORT=5432
APP_POSTGRES_USER=postgres
APP_POSTGRES_PASSWORD=postgres
APP_POSTGRES_DBNAME=ai_agent
APP_POSTGRES_SSL_MODE=disable
APP_POSTGRES_QUERY_TIMEOUT=10s
APP_POSTGRES_MAX_ROWS=100

MILVUS_IMAGE=milvusdb/milvus:v2.5.27
MILVUS_PORT=19530
MILVUS_WEBUI_PORT=19121
APP_MILVUS_ADDR=localhost:19530
APP_MILVUS_USERNAME=
APP_MILVUS_PASSWORD=
APP_MILVUS_DATABASE=default
APP_MILVUS_COLLECTION_NAME=documents_bge_m3
APP_MILVUS_DIMENSION=1024
APP_MILVUS_METRIC_TYPE=COSINE
APP_MILVUS_CONNECT_TIMEOUT=60s

APP_LLM_BASE_URL=https://api.openai.com
APP_LLM_API_KEY=
APP_QWEN_BASE_URL=http://host.docker.internal:11434
APP_QWEN_API_KEY=ollama
APP_LLM_REQUEST_TIMEOUT=180s

APP_EMBEDDING_BASE_URL=http://host.docker.internal:11434
APP_EMBEDDING_MODEL=bge-m3:latest
# Set an API key to use an OpenAI-compatible /embeddings endpoint instead of Ollama /api/embed.
APP_EMBEDDING_API_KEY=
APP_EMBEDDING_DIMENSION=1024
APP_EMBEDDING_BATCH_SIZE=32
APP_EMBEDDING_TIMEOUT=120s
# Use fresh collections and reimport documents when switching embedding models.
APP_MEMORY_SEMANTIC_COLLECTION=semantic_memory_v2

APP_RAG_SCORE_THRESHOLD=0.5
APP_RAG_ENABLE_RERANK=true

# 真实网络搜索。Compose 内会自动改为 http://searxng:8080。
SEARXNG_IMAGE=searxng/searxng:latest
SEARXNG_PORT=7070
SEARXNG_SECRET=agentgo-local-search-change-me
APP_SEARCH_BASE_URL=http://localhost:7070
APP_SEARCH_TIMEOUT=20s
APP_SEARCH_LANGUAGE=zh-CN
APP_SEARCH_SAFE_SEARCH=1

# 观测服务；端口默认只绑定宿主机 127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TEMPO_PORT=3200
OTEL_TRACES_SAMPLER_ARG=1.0
